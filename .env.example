# Supabase → Project Settings → API Keys (and Data API for the URL).
# Both values are safe to expose to the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never add the service_role / secret key to this project. It is not needed.
